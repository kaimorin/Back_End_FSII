# Copia este archivo como .env y completa los valores
# El .env NUNCA se sube a GitHub

# JWT
JWT_SECRET=cambia-esto-por-una-clave-secreta-de-al-menos-32-caracteres

# Base de datos
DB_PASSWORD=una-contrasena-segura

# MySQL root (solo necesario al crear el contenedor por primera vez)
MYSQL_ROOT_PASSWORD=otra-contrasena-segura

# Frontend (URL del frontend en producción)
CORS_ORIGIN=http://localhost:5173
